// Local development only. main is never deployed: the client preview is
// deployed from the design-variants branch (wrangler.building.jsonc there).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medsafar-local",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "medsafar-local"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Enquiries (lib/leads.ts), admin accounts and the changes made in /admin
  // (lib/content.ts), local copy only. NEXT_TAG_CACHE_D1 is the same database,
  // under the name OpenNext looks for: it records when /admin last changed
  // something, so cached pages are drawn again.
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "medsafar-leads-local",
      "database_id": "medsafar-leads-local",
      "migrations_dir": "migrations"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "medsafar-leads-local",
      "database_id": "medsafar-leads-local"
    }
  ],
  // Drawn pages (open-next.config.ts), local copy only.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "medsafar-pages-local"
    }
  ],
  // Uploaded medical reports (lib/leads.ts) and photos uploaded in /admin
  // (lib/media.ts), local copies only. Reports stay private; photos are served
  // at /media/<name>.
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "medsafar-reports-local"
    },
    // A second copy of each report, kept for 30 days (a lifecycle rule on
    // the real bucket deletes older copies).
    {
      "binding": "REPORTS_BACKUP",
      "bucket_name": "medsafar-reports-backup-local"
    },
    {
      "binding": "MEDIA",
      "bucket_name": "medsafar-media-local"
    }
  ],
  "observability": {
    "enabled": true
  }
}

// Local development only. main is never deployed: the client preview is
// deployed from the design-variants branch (wrangler.building.jsonc there).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medsafar-local",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "medsafar-local"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Enquiries (lib/leads.ts), local copy only.
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "medsafar-leads-local",
      "database_id": "medsafar-leads-local",
      "migrations_dir": "migrations"
    }
  ],
  // Uploaded medical reports (lib/leads.ts), local copy only.
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "medsafar-reports-local"
    }
  ],
  "observability": {
    "enabled": true
  }
}

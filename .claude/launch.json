{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "medsafar",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "medsafar-design",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "../Medsafar-design",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "medsafar-cloudflare",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "opennextjs-cloudflare",
        "preview",
        "--port",
        "8787"
      ],
      "port": 8787
    }
  ]
}

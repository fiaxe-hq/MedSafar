// Client preview at building-medsafar, on the xaif@fiaxe.com account. Kept
// apart from the live site: its own Worker, enquiry database and reports bucket.
// Deploy: pnpm run deploy. Migrate: pnpm run db:migrate. Both use this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "building-medsafar",
  "account_id": "0e9ed5067274fb68d2256f2fc86c7eaf",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "building-medsafar"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "building-medsafar-leads",
      "database_id": "c1068ffb-150c-4713-aaf8-a2cd1cd91163",
      "migrations_dir": "migrations"
    },
    // The same database, under the name OpenNext looks for: it records when
    // /admin last changed something, so cached pages are drawn again.
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "building-medsafar-leads",
      "database_id": "c1068ffb-150c-4713-aaf8-a2cd1cd91163"
    }
  ],
  // Drawn pages (open-next.config.ts).
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "9b78003f21ce4051bcbe36d301656e8b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "building-medsafar-reports"
    },
    // 30-day copies of each report; the bucket's lifecycle rule expires them.
    {
      "binding": "REPORTS_BACKUP",
      "bucket_name": "building-medsafar-reports-backup"
    },
    // Photos uploaded in /admin (lib/media.ts), served at /media/<name>.
    {
      "binding": "MEDIA",
      "bucket_name": "building-medsafar-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}

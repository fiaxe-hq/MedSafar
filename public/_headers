/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Photos are shown under a versioned address (lib/imageLoader.ts), so they
# can be kept for a year. Replacing one changes the version.
/photos/*
  Cache-Control: public,max-age=31536000,immutable

# Menu photos (scripts/thumbs.mjs), also under the photos version.
/thumbs/*
  Cache-Control: public,max-age=31536000,immutable
